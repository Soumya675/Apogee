<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
var SITEURL = "https://apogeects.com/";
$('body').on('click', '.buy_now', function(e){

//var totalAmount = $(this).attr("data-amount");
//var product_id =  $(this).attr("data-id");
var totalAmount =  $(this).data("amount");
var type =  $(this).data("type");
//alert(type);
var order_id =  $(this).data("id");
var rest_name =  "package";
var apikey =  "rzp_test_KXmy46XNHoyv0S";
var options = {
"key": apikey,
"amount": parseFloat(totalAmount)*100, // 2000 paise = INR 20
"name": rest_name,
"description": "Payment",
"image": "https://mockopedia.com/assets/images/logo/1634669803IMG-9017.PNG",
"handler": function (response){
$.ajax({
url: SITEURL + 'cart/razorPaySuccess',
type: 'post',
dataType: 'json',
data: {
razorpay_payment_id: response.razorpay_payment_id , order_id : order_id,totalAmount:totalAmount,payfortype:type
}, 
success: function (msg) {
window.location.href = SITEURL + 'cart/razor_thanku';
}
});
},
"theme": {
"color": "#00B9CF"

}
};
var rzp1 = new Razorpay(options);
rzp1.open();
e.preventDefault();
});

        
 $('.v-close').click(function() {
    location.reload();
});
</script>
